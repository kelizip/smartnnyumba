# Smart Nyumba Pro — Backend Configuration
# Copy to .env and fill in ALL values before starting
# Generate secrets with: node -e "require('crypto').randomBytes(64).toString('hex')"
# NEVER commit .env to git

# ── APPLICATION ──────────────────────────────────────────────
NODE_ENV=development
PORT=3002
APP_NAME=Smart Nyumba Pro
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://your-app.vercel.app,https://smartnyumba.co.ke
# In development this is auto-populated with localhost origins
ALLOWED_ORIGINS=

# ── SECURITY ─────────────────────────────────────────────────
# REQUIRED — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_256BIT_RANDOM_HEX
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# REQUIRED — AES-256-CBC key for PII fields (Kenya DPA 2019)
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
ENCRYPTION_KEY=REPLACE_WITH_32BYTE_HEX

# ── DATABASE (MySQL) ──────────────────────────────────────────
# Use 127.0.0.1 not localhost (avoids Unix socket issues)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartnyumba
DB_USER=root
DB_PASSWORD=
DB_POOL_LIMIT=30
# Set to 'true' when connecting to Railway/cloud MySQL (enforces TLS)
DB_SSL=false

# ── M-PESA (Safaricom Daraja) ─────────────────────────────────
# Leave blank to use demo/simulation mode (no real charges)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# ── SMS (Africa's Talking) ────────────────────────────────────
# Leave AT_API_KEY empty to use sandbox (SMS logged, not sent)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=SmartNyumba

# ── EMAIL (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The display name shown in From: field
SMTP_FROM=Smart Nyumba Pro <noreply@smartnyumba.com>

# ── FILE UPLOADS ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
# Storage driver: local | s3 | r2 | spaces
STORAGE_DRIVER=local
# S3-compatible credentials (required if STORAGE_DRIVER != local)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ── CRON ─────────────────────────────────────────────────────
# Set ENABLE_CRONS=false to disable all scheduled jobs (useful in test envs)
ENABLE_CRONS=true
# Secret for triggering cron jobs via external scheduler
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── WEBHOOKS ─────────────────────────────────────────────────
# HMAC-SHA256 signing key for outbound webhook payloads
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
WEBHOOK_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET

# ── CCTV / ACCESS CONTROL ────────────────────────────────────
# HMAC-SHA256 secret for verifying CCTV/access-control webhook payloads
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
CCTV_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# Set to '1' to enable live M-Pesa STK push (requires valid Daraja credentials)
# Leave as '0' in development/staging — falls back to simulation mode
MPESA_ENABLED=0

# ── WHATSAPP (optional) ───────────────────────────────────────
# Leave blank to disable WhatsApp notifications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── LOGGING ──────────────────────────────────────────────────
SLOW_QUERY_MS=500
